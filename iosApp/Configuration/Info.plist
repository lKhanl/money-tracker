<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Compose 120 Hz ekranlarda tam kare hızında çizebilsin. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Açılışta Android'deki açılış ekranıyla aynı koyu zemin; ardından uygulamanın kendi açılış ekranı gelir. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
